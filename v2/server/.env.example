# Copy to .env for local dev (this file is committed; .env is gitignored).
# On Render, set these as environment variables in the dashboard instead.

# MongoDB connection string. The database name is taken from the URI path.
# For a free hosted DB, create a MongoDB Atlas cluster and use its SRV string:
#   mongodb+srv://user:pass@cluster.xxxx.mongodb.net/superanki
MONGODB_URI=

# DeepSeek API key — powers the chat/tutor. https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Optional. The server reads PORT if set; Render injects it automatically.
# Defaults to 6767 locally.
# PORT=6767

# Optional. A shared password that locks down every data-changing request
# (create/edit/delete words, grade reviews, chat). The web app sends whatever the
# user types; the server allows the write only if it matches this exactly. Leave
# unset to disable the gate (handy for local dev). On Render, set it in the
# dashboard — never commit the real value, since this repo is public.
APP_PASSWORD=
