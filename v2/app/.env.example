# Copy to .env to point the app at a specific backend.
# EXPO_PUBLIC_* vars are inlined into the JS bundle at build time.

# Where the app finds the API. Leave unset for local dev — the app then guesses
# the host from the Expo dev server (device) or the current web origin, on port
# 6767. For a device/standalone build or the deployed web app, set this to your
# Render URL (no trailing slash):
EXPO_PUBLIC_API_URL=https://superanki-server.onrender.com
